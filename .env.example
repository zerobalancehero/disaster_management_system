# Environment Configuration Template
# Copy this file to .env and replace placeholder values

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL with PostGIS)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=disaster_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here
DB_URL=jdbc:postgresql://postgres:5432/disaster_db

# Security & JWT (Must be a secure 256-bit base64/hex key in production)
JWT_SECRET=replace_with_a_secure_minimum_256_bit_random_secret_key_here
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Machine Learning Inference Configuration
ML_MOCK_ENABLED=true
ML_MODEL_PATH=/app/models/disaster_risk_model.onnx

# Seed Development Data (true for local testing, false in production)
SEED_DEV_DATA=true

# External Providers Configuration
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ENABLED=true

USGS_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
USGS_ENABLED=true

GDACS_URL=https://www.gdacs.org/xml/rss.xml
GDACS_ENABLED=false

IMD_URL=https://api.imd.gov.in/public
IMD_API_KEY=your_optional_imd_api_key_here
IMD_ENABLED=false

OSRM_URL=http://osrm:5000
OSRM_ENABLED=false

# Optional Notification Dispatchers
EMAIL_NOTIFICATIONS_ENABLED=false
SMS_NOTIFICATIONS_ENABLED=false
